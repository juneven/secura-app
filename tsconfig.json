{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/app/index.jsx",
    "src/screens/HomeScreen.jsx",
    "src/screens/HistoryScreen.jsx",
    "src/screens/settings/UserDetailScreen.jsx",
    "src/screens/settings/SettingsScreen.jsx"
  ]
}
