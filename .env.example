# Salin file ini menjadi .env.local lalu isi (.env.local sudah diabaikan Git oleh .gitignore).

# Alamat backend SECURA (wajib HTTPS; http:// hanya diterima saat mode pengembangan)
EXPO_PUBLIC_API_URL=

# (Opsional) Alamat HTTPS pilihan Anda untuk menguji akses internet, BUKAN server SECURA.
# Kosong = status internet "belum dicek".
EXPO_PUBLIC_INTERNET_PROBE_URL=

# Supabase Auth (backend autentikasi). Pakai Publishable key SAJA, jangan secret key.
EXPO_PUBLIC_SUPABASE_URL=https://PROJECT-REF-ANDA.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ISI_KUNCI_ANDA
